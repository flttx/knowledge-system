# PostgreSQL connection string. Keep this server-only; do not prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/knowledge_system

# Vercel Blob private storage token. Set automatically when a private Blob store
# is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Browser users and Local Agent tokens are stored in PostgreSQL. Provision the
# first account after migration with:
#   npx tsx scripts/user-admin.ts create --username xuqing
